# Copy to .env and fill in. Generate secrets with: mix phx.gen.secret
# (or: openssl rand -base64 48)
SECRET_KEY_BASE=change-me
TOKEN_SIGNING_SECRET=change-me

# Public address of this qed instance
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000

# Host port to expose (default 4000)
# QED_PORT=4000
