{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qed",
  "identifier": "io.github.informatom.qed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "q.e.d.",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Static websites from a folder of pages",
    "license": "GPL-3.0-or-later",
    "category": "Productivity",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/qed.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNkI3RjZCQzlEMTNCOTgKUldTWU85SEphMzlySUptVFZqNUxOMEJ2N2QzcG1oWmVjc0lvNGJMc0g2K3c1cDRYeXZCNGVYaloK",
      "endpoints": [
        "https://github.com/informatom/qed/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
